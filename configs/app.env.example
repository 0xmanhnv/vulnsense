# This is an example environment file.
# Copy this file to .env in the project root and fill in your actual values.
# The .env file is ignored by git and docker.

# --- App Config ---
APP_ENV=development

# --- DB Config ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=vulnsense
DB_PASSWORD=yoursecurepassword # Make sure this is secure
DB_NAME=vulnsense_db
DB_SSL_MODE=disable

# --- Cache Config ---
CACHE_HOST=redis
CACHE_PORT=6379

# --- External Services Secrets & Pointers ---
SPLUNK_URL=https://your-splunk-instance:8089
SPLUNK_TOKEN=your-splunk-hec-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID= 